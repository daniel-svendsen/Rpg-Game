APP_DATABASE_URL=jdbc:postgresql://localhost:5432/simple_arpg
APP_DATABASE_USERNAME=postgres
APP_DATABASE_PASSWORD=replace-with-your-real-postgres-password
APP_JWT_SECRET=replace-this-with-a-secret-at-least-32-characters-long
APP_JWT_EXPIRATION_SECONDS=86400
APP_REQUEST_SIZE_AUTH_JSON_MAX=16KB
APP_REQUEST_SIZE_API_JSON_MAX=1MB
APP_SECURITY_PRODUCTION_MODE=false
APP_AUTH_TRUST_FORWARD_HEADERS=false
APP_AUTH_REGISTER_RATE_LIMIT_ENABLED=true
APP_AUTH_REGISTER_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=10
APP_AUTH_REGISTER_RATE_LIMIT_MAX_ATTEMPTS_PER_EMAIL=5
APP_AUTH_REGISTER_RATE_LIMIT_WINDOW=1m
APP_AUTH_LOGIN_RATE_LIMIT_ENABLED=true
APP_AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=8
APP_AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_EMAIL=5
APP_AUTH_LOGIN_RATE_LIMIT_WINDOW=1m
APP_PORT=8081
VITE_API_BASE_URL=http://localhost:8081
