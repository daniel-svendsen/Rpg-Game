# Convenience reference for AI agents and local setup.
# Canonical source files still include:
# - `dev.local.properties.example`
# - `compose.env.example`
# - `frontend/.env.example`
#
# Backend app settings
APP_DATABASE_URL=jdbc:postgresql://localhost:5432/simple_arpg
APP_DATABASE_USERNAME=postgres
APP_DATABASE_PASSWORD=replace-with-local-password
APP_JWT_SECRET=replace-with-32-plus-char-secret
APP_JWT_EXPIRATION_SECONDS=86400
APP_SECURITY_PRODUCTION_MODE=false
APP_AUTH_REGISTER_RATE_LIMIT_ENABLED=true
APP_AUTH_REGISTER_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=10
APP_AUTH_REGISTER_RATE_LIMIT_MAX_ATTEMPTS_PER_EMAIL=5
APP_AUTH_REGISTER_RATE_LIMIT_WINDOW=1m
APP_AUTH_LOGIN_RATE_LIMIT_ENABLED=true
APP_AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=8
APP_AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_EMAIL=5
APP_AUTH_LOGIN_RATE_LIMIT_WINDOW=1m
APP_CLIENT_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173
APP_SERVER_ADDRESS=127.0.0.1
APP_PORT=8080

# Frontend settings
VITE_API_BASE_URL=http://localhost:8080
# VITE_BASE_PATH=/your-repo/

# Optional Docker/demo values
POSTGRES_DB=simple_arpg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-demo-password
